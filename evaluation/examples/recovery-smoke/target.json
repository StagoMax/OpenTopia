{
  "schemaVersion": 1,
  "id": "recovery-mock-target",
  "command": "node",
  "args": ["mock-target.mjs"],
  "cwd": "{targetDir}",
  "promptTransport": "stdin",
  "eventTransport": "jsonl-file",
  "lifecycle": {
    "restart": {
      "kind": "command",
      "command": "node",
      "args": ["restart-target.mjs", "{targetStateFile}"],
      "cwd": "{targetDir}",
      "timeoutSeconds": 10
    }
  }
}
