{
  "schemaVersion": 1,
  "id": "CAL-SAFE-PATH-001",
  "version": "1.0.0",
  "title": "Harden archive extraction planning against path escapes",
  "suite": "opentopia-architecture-calibration-v1",
  "prompt": "Fix the archive extraction planner described in ISSUE.md. Treat this as a security-sensitive repository repair, retain the API, and run all tests. Do not modify ISSUE.md or test/.",
  "tags": ["calibration", "swe-bench-inspired", "security", "path-traversal", "javascript"],
  "fixture": { "source": "seed" },
  "budgets": { "watchdogSeconds": 900, "maxToolCalls": 100, "maxTotalTokens": 180000 },
  "graders": {
    "commands": [{ "id": "safe-path-contract", "command": "node", "args": ["grader.cjs", "{workspace}"], "timeoutSeconds": 120 }],
    "trajectory": { "requireValidEvents": true, "requireCompletionClaim": true },
    "security": { "protectedPaths": ["ISSUE.md", "test"], "forbiddenEventTypes": ["security.*"] }
  }
}
