{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opentopia.local/evaluation/suite.schema.json",
  "title": "Application evaluation suite",
  "type": "object",
  "required": ["schemaVersion", "id", "title", "tasks"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "evaluationClass": {
      "enum": ["conformance", "stress", "calibration", "external"]
    },
    "visibility": { "enum": ["public", "private", "sealed"] },
    "frozen": { "type": "boolean" },
    "benchmarkReferences": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "url", "influence"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "url": { "type": "string", "minLength": 1 },
          "influence": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    },
    "repetitions": { "type": "integer", "minimum": 1, "maximum": 100 },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "additionalProperties": false
}
