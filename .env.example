OPENTOPIA_DB=.opentopia/opentopia.db
OPENTOPIA_SERVER_URL=http://127.0.0.1:8787
# Required for direct server launches. Electron generates a fresh random token.
OPENTOPIA_API_TOKEN=replace-with-at-least-32-random-bytes
OPENTOPIA_PERMISSION=auto
OPENTOPIA_CONTEXT_WINDOW_TOKENS=128000
OPENTOPIA_CONTEXT_COMPACT_THRESHOLD_PERCENT=80
OPENTOPIA_SANDBOX_MODE=workspace-write
OPENTOPIA_SANDBOX_ENFORCEMENT=best-effort
OPENTOPIA_SANDBOX_NETWORK=deny
# OPENTOPIA_CODEX_SANDBOX_BIN=C:\path\to\codex.exe
# Sandbox mode: read-only | workspace-write | danger-full-access.
# Legacy disabled/best_effort/enforce values remain accepted for migration.
# Backend enforcement: disabled | best-effort | enforce.
# Additional writable roots (semicolon-separated on Windows).
# OPENTOPIA_SANDBOX_WRITABLE_ROOTS=C:\other\workspace;D:\shared
# Additional readable roots use OPENTOPIA_SANDBOX_READ_PATHS.
# Native Windows implementation: elevated | unelevated (default).
# OPENTOPIA_WINDOWS_SANDBOX=unelevated
# OPENTOPIA_SANDBOX_HOME=%LOCALAPPDATA%/OpenTopia/sandbox
# The generated Codex config is stored below this root in codex-home/config.toml.
OPENTOPIA_MODEL=gpt-4.1-mini
OPENTOPIA_OPENAI_BASE_URL=https://api.openai.com/v1
# OPENTOPIA_API_KEY=replace-with-provider-api-key
# Optional: load additional variables from another local env file.
# OPENTOPIA_ENV_FILE=C:\path\to\private\.env

# Optional SAG service used by the Library review surface. Electron reuses an
# existing endpoint and can start a trusted local runtime on Library entry.
# OPENTOPIA_SAG_URL=http://127.0.0.1:8765
# Development source project containing the enterprise-sag-panel entry point.
# Usually unnecessary when the project is next to OpenTopia; discovery is based
# on pyproject.toml rather than a fixed directory name.
# OPENTOPIA_SAG_PROJECT_ROOT=C:\path\to\sag-project
# Packaged or otherwise standalone sidecar executable.
# OPENTOPIA_SAG_EXECUTABLE=C:\path\to\enterprise-sag-panel.exe

# Optional Graph RAG service. See docs/library-retrieval-providers.md.
# OPENTOPIA_GRAPH_RAG_URL=http://127.0.0.1:8000
# OPENTOPIA_GRAPH_RAG_PROJECT_ROOT=C:\path\to\graph-rag-project
# OPENTOPIA_GRAPH_RAG_EXECUTABLE=C:\path\to\enterprise-graph-rag-panel.exe
# OPENTOPIA_GRAPH_RAG_TOKEN=replace-with-service-identity-token
