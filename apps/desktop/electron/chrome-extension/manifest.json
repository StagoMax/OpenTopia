{
  "manifest_version": 3,
  "name": "OpenTopia Chrome Bridge",
  "version": "0.1.0",
  "description": "Connects a user-approved Chrome tab to OpenTopia.",
  "key": "",
  "permissions": ["activeTab", "alarms", "debugger", "storage", "tabs"],
  "host_permissions": ["http://127.0.0.1/*"],
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_title": "Connect to OpenTopia",
    "default_popup": "popup.html"
  },
  "minimum_chrome_version": "116"
}
