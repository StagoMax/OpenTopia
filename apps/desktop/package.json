{
  "name": "@opentopia/desktop",
  "version": "0.1.0",
  "private": true,
  "author": "OpenTopia Contributors",
  "description": "Local-first desktop workbench for AI-assisted coding and long-running work.",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "predev": "node ../../scripts/ensure-agent-tools-runtime.cjs",
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "dev:renderer": "vite --host 127.0.0.1",
    "prestart": "node ../../scripts/ensure-agent-tools-runtime.cjs",
    "start": "electron .",
    "build": "tsc --noEmit && vite build",
    "contracts:check": "cargo run -q -p opentopia-core --example generate_desktop_contracts -- --output src/api/generated --check && cargo run -q -p opentopia-server -- --desktop-contracts-output src/api/generated --check-desktop-contracts && node scripts/generate-contract-types.mjs --check && node scripts/check-http-contract-coverage.mjs",
    "contracts:generate": "cargo run -q -p opentopia-core --example generate_desktop_contracts -- --output src/api/generated && cargo run -q -p opentopia-server -- --desktop-contracts-output src/api/generated && node scripts/generate-contract-types.mjs",
    "smoke:browser-host": "electron electron/browser-host-smoke.cjs",
    "pack": "pnpm build && electron-builder --dir",
    "dist": "pnpm build && electron-builder",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"src/**/*.test.ts\"",
    "test:electron": "node --test \"electron/*.test.cjs\"",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"electron/**/*.cjs\""
  },
  "build": {
    "appId": "ai.opentopia.desktop",
    "productName": "OpenTopia",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": ".runtime-stage",
        "to": ".",
        "filter": [
          "opentopia-runtime-manifest.json",
          "opentopia-server",
          "opentopia-server.exe",
          "opentopia-sandbox/opentopia-sandbox.exe",
          "agent-tools/**/*",
          "office-runtime/**/*",
          "sag/enterprise-sag-panel",
          "sag/enterprise-sag-panel.exe",
          "graph-rag/enterprise-graph-rag-panel",
          "graph-rag/enterprise-graph-rag-panel.exe"
        ]
      }
    ],
    "publish": {
      "provider": "github",
      "owner": "StagoMax",
      "repo": "OpenTopia",
      "releaseType": "draft"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.developer-tools",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "notarize": false
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development"
    }
  },
  "dependencies": {
    "@glideapps/glide-data-grid": "6.0.3",
    "@monaco-editor/react": "^4.7.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "docx-preview": "0.4.0",
    "electron-updater": "^6.6.0",
    "lodash": "^4.18.1",
    "lucide-react": "^0.575.0",
    "marked": "^4.3.0",
    "mermaid": "^11.16.1",
    "monaco-editor": "^0.52.2",
    "pdfjs-dist": "4.10.38",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-markdown": "^10.1.0",
    "react-responsive-carousel": "^3.2.23",
    "remark-gfm": "^4.0.1",
    "xterm": "^5.3.0",
    "xterm-addon-fit": "^0.8.0"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.4",
    "concurrently": "^9.2.1",
    "electron": "^41.0.0",
    "electron-builder": "^26.0.12",
    "json-schema-to-typescript": "^15.0.4",
    "prettier": "^3.8.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "wait-on": "^9.0.3"
  }
}
