{
  "name": "opentopia",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first desktop workbench for AI-assisted coding and long-running work.",
  "type": "module",
  "packageManager": "pnpm@10.30.0",
  "scripts": {
    "dev": "pnpm --filter @opentopia/desktop dev",
    "dev:desktop": "pnpm --filter @opentopia/desktop dev",
    "dev:server": "cargo run -p opentopia-server",
    "check": "cargo check --workspace && pnpm --filter @opentopia/desktop contracts:check && pnpm --filter @opentopia/desktop typecheck && pnpm --filter @opentopia/desktop test && pnpm design:check && pnpm boundary:check && pnpm test:evaluation",
    "test": "pnpm --filter @opentopia/desktop test",
    "test:evaluation": "node --test evaluation/test/*.test.mjs",
    "test:provider-release": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/test-provider-tool-cache-release.ps1",
    "eval:catalog": "node evaluation/src/cli.mjs catalog --root .opentopia/evaluations",
    "eval:regressions": "node evaluation/src/cli.mjs regressions --registry evaluation/regressions/registry.json --output .opentopia/evaluations/regressions.md",
    "boundary:check": "node scripts/check-evaluation-boundary.mjs",
    "design:check": "node scripts/check-design-system.mjs",
    "format": "pnpm --filter @opentopia/desktop format"
  },
  "engines": {
    "node": ">=22"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "electron-winstaller",
      "esbuild"
    ]
  }
}
